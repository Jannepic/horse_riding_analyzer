# Copy this file to .env.local and fill in the four values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored and must stay that way — two of these values are secrets.

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → your project → Connect (or Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Settings → API Keys → Publishable key.
# Safe in the browser: it grants no access on its own. RLS plus the signed-in
# user's JWT decide what is visible.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Settings → API Keys → Secret key.
# BYPASSES ROW LEVEL SECURITY. Server-side only — used by lib/supabase/admin.ts
# for the ingest script and for reading the shared corpus. It must NEVER carry
# the NEXT_PUBLIC_ prefix, or Next.js would bake it into the browser bundle.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ── OpenRouter ──────────────────────────────────────────────────────────────
# openrouter.ai/keys — one key for chat, embeddings and the vision model.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxx
